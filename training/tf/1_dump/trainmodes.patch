+
+// Build modes of the training-data tools (training/tf/1_dump/trainmodes.patch,
+// built by build_dump_tools.sh with -DTRAIN_MODE=<n>).  Without the define the
+// source builds the compressor, unchanged.
+//   1  stream: "-e" stops after the preprocessing and keeps the coder stream,
+//      packed (<out>.cmix.temp) and before the pack step (<out>.cmix.temp.vorpack)
+//   2  dump:   "-n" on the unpacked stream writes the rows fed to the
+//      transformer (paket-zeilen.bin), the zone mask (zonenmaske.u8) and the
+//      match channel (match-bytes.uint8, match-len.uint8); while coding, the
+//      transformer forward step and all models except the match models are off
+//   3  priors: as 2, but PPMd is the only model while coding; it also writes
+//      the PPMd distribution of every byte fed to PPMd (ppmd-probs.float16)
+//      and the token of that byte (ppmd-bytes.uint8)
+// The archive of a run in mode 2 or 3 is not decodable.  All outputs go to
+// the working directory.
+#ifndef TRAIN_MODE
+#define TRAIN_MODE 0
+#endif
+#define TRAIN_STREAM (TRAIN_MODE == 1)
+#define TRAIN_FEED (TRAIN_MODE == 2 || TRAIN_MODE == 3)
+#define TRAIN_PRIORS (TRAIN_MODE == 3)
+
+#endif  // TRAIN_MODE_H_
