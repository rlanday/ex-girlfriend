# Section 8, continued: the remaining 77 of the 200 bf16 epochs. Warm start
# from the epoch-123 checkpoint with optimizer state, continued schedule
# (TFT_SCHED_TOTAL_EPOCHS=200, TFT_SCHED_DONE_EPOCHS=123). Run with
# kette_arm.sh; wiederanlauf.sh <checkpoint> bf16 123 with file 08 sets the
# same variables. Package D, 4 cards (accumulation 2).
# End of bf16: sha256 ce2ce0c933dd3569... (file not kept). Before qat,
# fix_subnormal_rows.py lifts the 77 rows in 35 matrices whose maxima are below
# 1e-30 (subnormal); the result has sha256
# 377e6a7feaf413d6d2dbc52dd3cf91f4415cd73608c8ada196d9f73e2819f1ab,
# the start of section 9.

TFT_GEOMETRY=poc8m_w2048
PK_DUMP_DIR=/root/pkg_v7
TFT_DATA_DIR=/root/pkg_v7
TFT_MMAP=1
ZCTX_ARM=pkd
ZCTX_SEED=20260901
PK_LAST_X0ROW=1
PK_REDIRMERGE=1
PK_SLOT_DIM=16
TFT_MICRO_BATCH_TOKENS=131072
TFT_OPTIMIZER_BATCH_TOKENS=1048576
TFT_EPOCHS_BF16=77
TFT_EPOCHS_QAT=32
TFT_EPOCHS_FP32=4
TFT_CHECKPOINT_EVERY=1
TFT_WARMSTART=/root/ckpt/p15_bf16_ep123.tch
TFT_WARMSTART_OPT=/root/ckpt/p15_bf16_ep123.tch.opt
TFT_LOG_DIR=/root/logs_p15
TFT_EXPORT_DIR=/root/export_p15
TFT_RUN_TAG=p15
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
KINJ_OPTSTATE=1
TFT_SCHED_TOTAL_EPOCHS=200
TFT_SCHED_DONE_EPOCHS=123
