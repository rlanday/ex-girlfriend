# Section 3: window 1536 (poc8m_w1536). Warm start from the section 2 bf16 end
# (sha256 d696edb8..., /root/ckpt/w1024_bf16.tch + .opt).
# Package B (stream, priors and prior0 as in A; prompt rows changed).
# 120 bf16 epochs, fresh schedule; qat and fp32 values are placeholders, only
# the bf16 end is used. 4 cards (accumulation 2).
# End: sha256 e4026626e5ea8139..., kept as /root/ckpt/w1536v8_ep120.tch (+ .opt).

TFT_GEOMETRY=poc8m_w1536

PK_DUMP_DIR=/root/pkg_v7
TFT_DATA_DIR=/root/pkg_v7
TFT_MMAP=1
ZCTX_ARM=pkd
ZCTX_SEED=20260901
PK_LAST_X0ROW=1
PK_REDIRMERGE=1
PK_SLOT_DIM=16

TFT_MICRO_BATCH_TOKENS=131072
TFT_OPTIMIZER_BATCH_TOKENS=1048576

TFT_EPOCHS_BF16=120
TFT_EPOCHS_QAT=1
TFT_EPOCHS_FP32=1
TFT_CHECKPOINT_EVERY=1

TFT_WARMSTART=/root/ckpt/w1024_bf16.tch
TFT_WARMSTART_OPT=/root/ckpt/w1024_bf16.tch.opt

TFT_LOG_DIR=/root/logs_w1536v8
TFT_EXPORT_DIR=/root/export_w1536v8
TFT_RUN_TAG=w1536v8
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
KINJ_OPTSTATE=1
