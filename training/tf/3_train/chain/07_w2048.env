# the qat and fp32 phases of this arm are not part of the line.
# 4 cards (accumulation 2). End: sha256 02ef775c035f5900..., kept as
# /root/ckpt/p14_bf16_ende.tch (+ .opt) for section 8.
# The values are those of the environment file the run used.

TFT_GEOMETRY=poc8m_w2048
