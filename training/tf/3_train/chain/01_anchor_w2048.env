# Section 1: anchor, cold start (no warm start), window 2048 (poc8m_w2048).
# Package A. Plan 80 bf16 epochs, fresh schedule. The qat and fp32 values are
# placeholders (tft/config.py requires epochs >= 1); only the bf16 end is used.
# 2 cards (KARTEN=0,1, accumulation 4). The run is split: 13 epochs, then a
# resume from the epoch-13 checkpoint (sha256 ed5ac02a0e0ae37e...) with
#   ENVD=<this file> KARTEN=0,1 bash wiederanlauf.sh <checkpoint> bf16 13
# (continued schedule TOTAL=80 DONE=13, 67 epochs, optimizer state carried).
# End: models/poc8m_w2048-pkd.tch, sha256 11f26e97dac824d7...,
# kept as /root/ckpt/a8m_2048-ep80.tch (+ .opt) for section 2.

TFT_GEOMETRY=poc8m_w2048

PK_DUMP_DIR=/root/pkg_v7
TFT_DATA_DIR=/root/pkg_v7
TFT_MMAP=1
ZCTX_ARM=pkd
ZCTX_SEED=20260901
PK_LAST_X0ROW=1
PK_REDIRMERGE=1
PK_SLOT_DIM=16

TFT_MICRO_BATCH_TOKENS=131072
TFT_OPTIMIZER_BATCH_TOKENS=1048576

TFT_EPOCHS_BF16=80
TFT_EPOCHS_QAT=1
TFT_EPOCHS_FP32=1
TFT_CHECKPOINT_EVERY=1

TFT_LOG_DIR=/root/logs_a8m_2048
TFT_EXPORT_DIR=/root/export_a8m_2048
TFT_RUN_TAG=a8m_2048
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
KINJ_OPTSTATE=1
