# Section 5: window 2048 (poc8m_w2048). Warm start from the section 4 end
# (sha256 bb420a689b9491f8..., /root/ckpt/w1536v8_ep280.tch + .opt).
# Package B. 200 bf16 epochs, fresh schedule; the 6 qat and 1 fp32 epochs of
# this arm are not part of the line. 4 cards (accumulation 2).
# The run is split after epoch 96: a resume from the epoch-96 checkpoint
# (sha256 768e489bc7053e89..., with optimizer state) with
# the continued schedule TOTAL=200 DONE=96 (104 epochs), which is what
#   ENVD=<this file> bash wiederanlauf.sh <epoch-96 checkpoint> bf16 96
# does. End: sha256 f83fc26de816f4e4..., kept as /root/ckpt/w2048v8_ep600.tch
# (+ .opt) for section 6.

TFT_GEOMETRY=poc8m_w2048
PK_DUMP_DIR=/root/pkg_v7
TFT_DATA_DIR=/root/pkg_v7
TFT_MMAP=1
ZCTX_ARM=pkd
ZCTX_SEED=20260901
PK_LAST_X0ROW=1
PK_REDIRMERGE=1
PK_SLOT_DIM=16
TFT_MICRO_BATCH_TOKENS=131072
TFT_OPTIMIZER_BATCH_TOKENS=1048576
TFT_EPOCHS_BF16=200
TFT_EPOCHS_QAT=6
TFT_EPOCHS_FP32=1
TFT_CHECKPOINT_EVERY=1
TFT_WARMSTART=/root/ckpt/w1536v8_ep280.tch
TFT_WARMSTART_OPT=/root/ckpt/w1536v8_ep280.tch.opt
TFT_LOG_DIR=/root/logs_block200
TFT_EXPORT_DIR=/root/export_block200
TFT_RUN_TAG=block200
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
KINJ_OPTSTATE=1
