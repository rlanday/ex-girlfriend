# Section 9: qat, 32 epochs (learning rate 2.5e-6, warmup over all 32 epochs)
# on the lifted bf16 end, which qat_arm.sh reads as
# models/poc8m_w2048-pkd.tch (sha256 377e6a7feaf413d6...). qat_arm.sh unsets
# the warm start and schedule variables; TFT_EPOCHS_BF16 is not read.
# Package D, 4 cards (accumulation 2). The 4 fp32 epochs that qat_arm.sh
# starts afterwards are not used; section 10 runs the fp32 phase.
# End: models/poc8m_w2048-pkd-q4.tch, sha256 2a698b86c7430daa...

TFT_GEOMETRY=poc8m_w2048
PK_DUMP_DIR=/root/pkg_v7
TFT_DATA_DIR=/root/pkg_v7
TFT_MMAP=1
ZCTX_ARM=pkd
ZCTX_SEED=20260901
PK_LAST_X0ROW=1
PK_REDIRMERGE=1
PK_SLOT_DIM=16
TFT_MICRO_BATCH_TOKENS=131072
TFT_OPTIMIZER_BATCH_TOKENS=1048576
TFT_EPOCHS_BF16=77
TFT_EPOCHS_QAT=32
TFT_EPOCHS_FP32=4
TFT_CHECKPOINT_EVERY=1
TFT_WARMSTART=/root/ckpt/p15_bf16_ep123.tch
TFT_WARMSTART_OPT=/root/ckpt/p15_bf16_ep123.tch.opt
TFT_LOG_DIR=/root/logs_p15f
TFT_EXPORT_DIR=/root/export_p15f
TFT_RUN_TAG=p15f
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
KINJ_OPTSTATE=1
TFT_SCHED_TOTAL_EPOCHS=200
TFT_SCHED_DONE_EPOCHS=123
