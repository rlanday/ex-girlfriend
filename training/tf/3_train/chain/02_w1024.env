# Section 2: window 1024 (poc8m_w1024). Warm start from the section 1 end
# (sha256 11f26e97dac824d7..., /root/ckpt/a8m_2048-ep80.tch + .opt).
# Package A. 40 bf16 epochs, fresh schedule. 2 cards (KARTEN=0,1,
# accumulation 4). The 16 qat and 2 fp32 epochs of this arm are not part of
# the line. End of bf16: sha256 d696edb8..., kept as /root/ckpt/w1024_bf16.tch
# (+ .opt) for section 3.

TFT_GEOMETRY=poc8m_w1024

PK_DUMP_DIR=/root/pkg_v7
TFT_DATA_DIR=/root/pkg_v7
TFT_MMAP=1
ZCTX_ARM=pkd
ZCTX_SEED=20260901
PK_LAST_X0ROW=1
PK_REDIRMERGE=1
PK_SLOT_DIM=16

TFT_MICRO_BATCH_TOKENS=131072
TFT_OPTIMIZER_BATCH_TOKENS=1048576

TFT_EPOCHS_BF16=40
TFT_EPOCHS_QAT=16
TFT_EPOCHS_FP32=2
TFT_CHECKPOINT_EVERY=1

TFT_WARMSTART=/root/ckpt/a8m_2048-ep80.tch
TFT_WARMSTART_OPT=/root/ckpt/a8m_2048-ep80.tch.opt

TFT_LOG_DIR=/root/logs_z8m_1024
TFT_EXPORT_DIR=/root/export_z8m_1024
TFT_RUN_TAG=z8m_1024
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
KINJ_OPTSTATE=1
