+  if (!t) {
+    fprintf(stderr, "CMX semin: no memory for the extra end-stage weights\n");
+    exit(1);
+  }
+  cmx_si_w_ = t;
+  cmx_si_g_ = t + (r1 + r2 + r3) * 2;
+  cmx_si_o2_ = r1;
+  cmx_si_o3_ = r1 + r2;
+  fprintf(stderr, "CMXTEL semin init mode=%d stage_rows=%zu/%zu/%zu final_mixer_cols=%s\n", cmx_meas::g_semin, r1, r2, r3,
