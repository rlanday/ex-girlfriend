+    {
+      unsigned long long* c = cmx_meas::g_sk2_cnt[sk][cmx_meas::g_region];
+      const int h2 = cmx_sk_h2_[sk];
+      if (h2 >= 0) ++c[0];
+      if (h1 >= 0) ++c[1];
+      if (h1 >= 0 && h2 >= 0) {
+        ++c[2];
+        c[3] += h1 == h2;
+        c[4] += h1 == pb;
+        c[5] += h2 == pb;
+        c[6] += h2 == pb && h1 != pb;
+        c[7] += h1 == pb && h2 != pb;
+      } else if (h2 >= 0) {
+        ++c[8];
+        c[9] += h2 == pb;
+      } else if (h1 >= 0) {
+        ++c[11];
