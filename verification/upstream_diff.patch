+#if PORT_RESTORE_IND
+#define PORT_IND_COLS 2
+#else
+#define PORT_IND_COLS 0
+#endif
+
+#if PORT_GEOM
+#define PORT_N0 (589 + PORT_IND_COLS)
+#define PORT_N1 28
+#else
+#define PORT_N0 (588 + PORT_IND_COLS)
+#define PORT_N1 27
+#endif
+
+#endif
